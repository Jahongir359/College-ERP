msgstr "Captchani tekshirib boʻlmadi. Qaytadan urinib koʻring."

msgid "Invalid captcha. Try again."
msgstr "Captcha notoʻgʻri. Qaytadan urinib koʻring."

msgid "Please enter both your ID/email and password."
msgstr "Iltimos, ID/email va parolni kiriting."

msgid "Too many failed login attempts. Please wait 15 minutes before trying again."
msgstr "Juda koʻp muvaffaqiyatsiz urinish. Qaytadan urinishdan oldin 15 daqiqa kuting."

msgid "Login is temporarily unavailable. Please try again in a moment."
msgstr "Kirish vaqtincha ishlamayapti. Birozdan soʻng qaytadan urinib koʻring."

msgid "Account not found."
msgstr "Hisob topilmadi."

msgid "Incorrect password."
msgstr "Parol notoʻgʻri."

msgid "ID not found. Please check your ICEBERG login ID."
msgstr "ID topilmadi. ICEBERG login ID ingizni tekshiring."

msgid "Login failed due to a server issue. Please try again shortly."
msgstr "Server muammosi tufayli kirib boʻlmadi. Birozdan soʻng qaytadan urinib koʻring."

msgid "Your account role is not configured correctly. Please contact the administrator."
msgstr "Hisobingiz roli notoʻgʻri sozlangan. Administratorga murojaat qiling."

