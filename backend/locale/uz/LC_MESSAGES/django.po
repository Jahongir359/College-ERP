msgstr "Kirish xatlarini chop etish"

msgid "Print login letters for the parents who have not signed in yet? Each gets a new temporary password."
msgstr "Hali kirmagan ota-onalar uchun kirish xatlari chop etilsinmi? Har biriga yangi vaqtinchalik parol beriladi."

#, python-format
msgid "%(n)s login letter"
msgid_plural "%(n)s login letters"
msgstr[0] "%(n)s ta kirish xati"
msgstr[1] "%(n)s ta kirish xati"

#, python-format
msgid "%(n)s parent in %(name)s has not signed in yet."
msgid_plural "%(n)s parents in %(name)s have not signed in yet."
msgstr[0] "%(name)s sinfidagi %(n)s ota-ona hali kirmagan."
msgstr[1] "%(name)s sinfidagi %(n)s ota-ona hali kirmagan."
