msgstr "Avval oʻquv yilini sozlang: davomat uning sinflari boʻyicha yuritiladi."

msgid "No classes in this academic year yet."
msgstr "Bu oʻquv yilida hali sinflar yoʻq."

#, python-format
msgid "%(taken)s of %(total)s classes took the register"
msgstr "%(total)s ta sinfdan %(taken)s tasida davomat olindi"

msgid "classes took the register"
msgstr "sinfda davomat olindi"

msgid "Not taken yet"
msgstr "Hali olinmagan"

msgid "No homeroom teacher"
msgstr "Sinf rahbari yoʻq"

msgid "Every class has taken today's register."
msgstr "Barcha sinflarda bugungi davomat olindi."

msgid "Open the register report"
msgstr "Davomat hisobotini ochish"

msgid "Quick links"
msgstr "Tezkor havolalar"

msgid "Register"
msgstr "Davomat"

msgid "No quarter has started yet."
msgstr "Hali birorta chorak boshlanmagan."

msgid "No current academic year is set."
msgstr "Joriy oʻquv yili belgilanmagan."

msgid "Set one up"
msgstr "Sozlash"

msgid "parents haven't signed in yet"
msgstr "ota-ona hali tizimga kirmagan"

msgid "pupils have no parent linked"
msgstr "oʻquvchiga ota-ona bogʻlanmagan"

msgid "Open parents"
msgstr "Ota-onalarni ochish"

# P3.9 admin shell
msgid "Staff"
msgstr "Xodimlar"

msgid "Account menu"
msgstr "Hisob menyusi"

msgid "Dark mode"
msgstr "Tungi rejim"

msgid "Light mode"
msgstr "Kunduzgi rejim"

msgid "All branches"
msgstr "Barcha filiallar"
# Web audit fixes B1, M1 (2026-10-31)
msgid "Choose a branch."
msgstr "Filialni tanlang."

msgid "Classroom or room number, e.g. Room 3A"
msgstr "Sinf xonasi yoki xona raqami, masalan: 3A-xona"

msgid "School classes only: the academic year."
msgstr "Faqat maktab sinflari uchun: oʻquv yili."

msgid "This student can't be added to this class: they are not in this branch."
msgstr "Bu oʻquvchini sinfga qoʻshib boʻlmaydi: u bu filialda emas."
